<?xml version="1.0" encoding="utf-8"?>
<!--
    Android blocks plain HTTP by default, which is correct — but it also means
    a debug build cannot reach `php artisan serve` on your laptop.

    This allows cleartext ONLY to private network addresses, and ONLY in a
    debug build (see AndroidManifest: the release build does not reference
    this file). A release APK still refuses plain HTTP everywhere.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- the emulator's route to your machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- localhost, for anything running on the device itself -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>

        <!--
            Your laptop on the wifi. CHANGE THIS to whatever `ipconfig` shows,
            then rebuild — the value is compiled in, so hot reload will not
            pick up an edit here.
        -->
        <domain includeSubdomains="false"> 192.168.100.47</domain>
    </domain-config>
</network-security-config>
